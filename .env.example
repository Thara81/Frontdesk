# Copy to .env and replace every value. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# sqlite (local default), mysql, or postgres
# DATABASE_URL takes precedence over DB_ENGINE when set.
DB_ENGINE=sqlite
DATABASE_URL=
DB_NAME=frontdesk
DB_USER=frontdesk
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONN_MAX_AGE=60
# Optional CA certificate path for managed MySQL TLS connections
DB_SSL_CA=

SLA_TIME_ZONE=Asia/Kolkata
SLA_WORK_START=09:30
SLA_WORK_END=18:30
SLA_WORK_DAYS=0,1,2,3,4
SLA_AUTO_CLOSE_BUSINESS_DAYS=5
SLA_REOPEN_BUSINESS_DAYS=5

DEFAULT_FROM_EMAIL=frontdesk@example.com
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
